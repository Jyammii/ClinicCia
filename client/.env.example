# Local development normally uses Vite's proxy, so these may stay unset.
# For a separately deployed Vercel frontend, use the Render API URL without a
# trailing slash.  VITE_ASSET_URL makes uploaded image paths resolve to Render.
VITE_API_URL=https://your-clinicnow-api.onrender.com/api
VITE_ASSET_URL=https://your-clinicnow-api.onrender.com
